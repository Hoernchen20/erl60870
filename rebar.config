%% -*- erlang -*-

{minimum_otp_vsn, "26"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_import,
    warn_unused_vars,
    warn_export_vars,
    warn_untyped_record
]}.

{deps, [
    {ranch, "~> 2.1"}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [ssl, ranch]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [{proper, "1.4.0"}]}
    ]}
]}.

{shell, [
    {apps, [iec60870]}
]}.

%% `eunit' runs before `xref'/`dialyzer': as the last step of an alias its
%% test-profile app-linking races the first `-include_lib' of the app's own
%% header (rebar3 3.25). CI runs the steps as separate invocations regardless.
{alias, [
    {check, [compile, eunit, xref, dialyzer]}
]}.
