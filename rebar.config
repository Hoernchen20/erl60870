%% -*- erlang -*-

{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_import,
    warn_unused_vars,
    warn_export_vars,
    warn_untyped_record
]}.

{deps, [
    {ranch, "~> 2.1"}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [ssl, ranch]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [{proper, "1.4.0"}]}
    ]}
]}.

{shell, [
    {apps, [iec60870]}
]}.

%% API docs come from the `-moduledoc' / `-doc' attributes in the source (the
%% OTP 27 compiler stores them in each `.beam' "Docs" chunk). `rebar3 ex_doc'
%% renders the HTML site — see the README for how to run it and the OTP caveat.
{project_plugins, [rebar3_ex_doc]}.

%% `rebar3 ex_doc' runs edoc first to collect the doc chunks; its preprocessor
%% needs the umbrella app's own `include/' on the path so
%% `-include_lib("iec60870/include/...")' resolves (rebar3 does not stage a
%% project app's headers under _build).
{edoc_opts, [{includes, ["apps", "apps/iec60870/src", "apps/iec60870/include"]}]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"docs/DESIGN.md", #{title => "Design"}},
        {"LICENSE", #{title => "License"}}
    ]},
    {main, "readme"},
    {api_reference, true}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

%% `eunit'/`ct' run before `xref'/`dialyzer' but are kept out as the *last*
%% alias step: a test-profile run left last races the first `-include_lib' of
%% the app's own header on recompile (rebar3 3.25). `ct' is left out of the
%% alias entirely for the same reason — run it on its own (CI does). CI runs
%% every step as a separate invocation regardless.
{alias, [
    {check, [compile, eunit, xref, dialyzer]}
]}.
