{application, iec60870, [
    {description, "IEC 60870-5 telecontrol protocol library (104 server first)"},
    {vsn, "0.1.0"},
    {registered, [iec60870_sup, iec60870_registry, iec60870_instances_sup]},
    {mod, {iec60870_app, []}},
    {applications, [
        kernel,
        stdlib,
        ssl,
        ranch
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/Hoernchen20/erl60870"}]}
]}.
